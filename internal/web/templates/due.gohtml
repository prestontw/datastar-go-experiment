{{define "due-head"}}
<style>
  @scope (.due-board) {
    :scope { display: block; min-height: calc(100vh - 4.5rem); padding: 2.5rem 4vw 4rem; background: radial-gradient(circle at 85% 0%, #dcefe9 0%, transparent 32%), var(--paper); }
    h1, h2, p { margin-top: 0; }
    .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; max-width: 76rem; margin: 0 auto 2rem; }
    .eyebrow { margin-bottom: .35rem; color: var(--brand); font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    h1 { margin-bottom: .35rem; font-family: Georgia, serif; font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 500; letter-spacing: -.05em; }
    .lede { margin: 0; color: var(--muted); }
    .window-picker { display: flex; gap: .3rem; padding: .3rem; border: 1px solid var(--line); border-radius: .8rem; background: white; }
    .window-picker a { padding: .52rem .75rem; border-radius: .55rem; color: var(--muted); font-size: .8rem; text-decoration: none; }
    .window-picker a[aria-current="true"] { color: white; background: var(--brand); font-weight: 750; }
    .summary { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 76rem; margin: 0 auto 1rem; }
    .summary-card { padding: 1.2rem 1.35rem; border: 1px solid var(--line); border-radius: .9rem; background: rgb(255 255 255 / 80%); }
    .summary-card strong { display: block; font-family: Georgia, serif; font-size: 2rem; font-weight: 500; }
    .summary-card span { color: var(--muted); font-size: .8rem; }
    .summary-card.alert strong { color: var(--coral); }
    .task-table { max-width: 76rem; margin: auto; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: white; box-shadow: var(--shadow); }
    .table-heading, .task-row { display: grid; grid-template-columns: minmax(14rem, 1.5fr) minmax(11rem, 1fr) 9rem 7rem 3rem; align-items: center; gap: 1rem; padding: 0 1.3rem; }
    .table-heading { min-height: 3rem; color: var(--muted); background: #f4f8f6; font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .task-row { min-height: 5rem; border-top: 1px solid #e7eeeb; }
    .task-title { margin: 0 0 .2rem; font-size: .94rem; font-weight: 720; }
    .patient-link { color: var(--brand-dark); font-size: .82rem; font-weight: 700; text-decoration: none; }
    .patient-link:hover { text-decoration: underline; }
    .priority { width: fit-content; padding: .3rem .55rem; border-radius: 2rem; color: var(--brand-dark); background: #e6f3ef; font-size: .7rem; font-weight: 800; text-transform: capitalize; }
    .priority.urgent { color: #8f3525; background: #ffe8e1; }
    .priority.important { color: #79550e; background: #fff2cf; }
    .due { color: var(--muted); font-size: .78rem; }
    .due.overdue { color: var(--coral); font-weight: 800; }
    .toggle { display: grid; width: 1.9rem; height: 1.9rem; place-items: center; padding: 0; border: 1px solid #aec1bb; border-radius: 50%; color: transparent; background: white; cursor: pointer; }
    .toggle:hover { color: var(--brand); border-color: var(--brand); }
    .empty { padding: 5rem 2rem; color: var(--muted); text-align: center; }
    .empty strong { display: block; margin-bottom: .35rem; color: var(--ink); font-size: 1.1rem; }
    .architecture-note { max-width: 76rem; margin: 1.2rem auto 0; padding-left: 1rem; color: var(--muted); border-left: 3px solid #b8d9d0; font-size: .78rem; line-height: 1.55; }
    @media (max-width: 820px) {
      :scope { padding: 1.5rem 1rem 3rem; }
      .page-heading { align-items: start; flex-direction: column; }
      .task-table { overflow-x: auto; }
      .table-heading, .task-row { min-width: 48rem; }
    }
    @media (max-width: 520px) { .summary { grid-template-columns: 1fr; } }
  }
</style>
{{end}}

{{define "due-view"}}
<main id="morph" class="due-board" aria-live="polite">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Practice-wide view</p>
      <h1>Due tasks</h1>
      <p class="lede">Open work across every patient, ordered by urgency.</p>
    </div>
    <nav class="window-picker" aria-label="Due date window">
      <a href="/tasks/due?window=7" {{if eq .Query.Days 7}}aria-current="true"{{end}}>7 days</a>
      <a href="/tasks/due?window=14" {{if eq .Query.Days 14}}aria-current="true"{{end}}>14 days</a>
      <a href="/tasks/due?window=30" {{if eq .Query.Days 30}}aria-current="true"{{end}}>30 days</a>
    </nav>
  </header>

  <section class="summary" aria-label="Due task summary">
    <div class="summary-card alert"><strong>{{.OverdueCount}}</strong><span>Overdue tasks</span></div>
    <div class="summary-card"><strong>{{.DueSoonCount}}</strong><span>Due in the next {{.Query.Days}} days</span></div>
  </section>

  <section class="task-table" aria-label="Tasks due within {{.Query.Days}} days">
    <header class="table-heading"><span>Task</span><span>Patient</span><span>Priority</span><span>Due</span><span>Done</span></header>
    {{if .Tasks}}
      {{range .Tasks}}
      <article class="task-row">
        <div><p class="task-title">{{.Title}}</p><span class="patient-link">Care task</span></div>
        <a class="patient-link" href="/patients?patient={{.PatientID}}&amp;status=open">{{.PatientName}}</a>
        <span class="priority {{.Priority}}">{{.Priority}}</span>
        <time class="due {{dueClass .DueDate $.Today}}" datetime="{{isoDate .DueDate}}">{{dueLabel .DueDate $.Today}}</time>
        <button class="toggle" type="button" aria-label="Complete {{.Title}}" data-on:click="@post('/commands?command=toggle-task&amp;task={{.ID}}')">✓</button>
      </article>
      {{end}}
    {{else}}
      <p class="empty"><strong>Nothing due in this window</strong>Tasks created from the patient dashboard will appear here in realtime.</p>
    {{end}}
  </section>
  <p class="architecture-note">This is a separate page and query-param view on the same homogeneous database event stream. Every committed change asks this route to recompute its latest full <code>&lt;main&gt;</code>; events are throttled and intermediate frames can be dropped safely.</p>
</main>
{{end}}
