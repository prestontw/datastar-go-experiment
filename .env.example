# Copy to .env in each worktree and give each agent a unique DATABASE_NAME and
# APP_PORT. In a Nix shell PostgreSQL defaults to a shared user-level Nix
# process; outside Nix it defaults to the shared Docker Compose service.
DATABASE_NAME=patient_dashboard
APP_PORT=8443

# Shared infrastructure port; only change it consistently across all worktrees.
# POSTGRES_PORT=5432

APP_SECRET=replace-with-at-least-32-random-bytes
TLS_CERT_FILE=.certs/localhost.pem
TLS_KEY_FILE=.certs/localhost-key.pem
