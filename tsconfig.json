{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "internal/web/assets/**/*.js",
    "tests/**/*.js",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
